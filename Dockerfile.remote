# A worker image for evedesign.remote: this checkout with the `remote` extra, plus the
# extras of the models it should run, pinned by uv.lock. Launchers start
# `python -m evedesign.remote.worker` themselves, so there is no entrypoint.
#
#   docker build -t evedesign-worker .                                   # core models only
#   docker build --build-arg EXTRAS="remote esm2" -t evedesign-esm2 .    # plus a model's extras
#
# Weights: bake them in with a further RUN step, or mount them (target `mounts`).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /bin/uv

ARG EXTRAS="remote"
# UV_COMPILE_BYTECODE: workers run as the caller's uid and cannot write .pyc files, so
# without it every start recompiles numpy, torch, ...
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH

WORKDIR /opt/evedesign
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# pip in the venv: Modal builds its layers on the image with `python -m pip install ...`
RUN uv sync --frozen --no-dev --no-editable $(printf -- '--extra %s ' $EXTRAS) \
 && uv pip install --python /opt/venv/bin/python pip \
 && python -m pip --version && python -c "import evedesign.remote.worker"
